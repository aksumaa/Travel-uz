# Database Connection String
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/traveluz

# JWT Security Credentials
JWT_SECRET_KEY=super-secret-jwt-key-change-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Anthropic AI Service (Key read server-side only, NEVER exposed to client)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Telegram Bot Co-Pilot & Background Worker
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WORKER_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ENCRYPTION_KEY=gAAAAABlXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx=

# Google Maps & Places Service (Server-side API Key for Geocoding, Places, Directions)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GOOGLE_PLACES_API_KEY=

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost
